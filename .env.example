# Example environment for local development. Dummy values only.
# Never put real keys, seed phrases or wallet data in this file or the repo.
# Real bot config lives in each bot's data volume (~/.automaton/automaton.json).

# Money: simulated ledger unless Halco explicitly switches it.
LEDGER_MODE=sim

# Bots reach Ollama only through the gateway on their own network.
OLLAMA_BASE_URL=http://ollama-gw:11434

# Placeholder; bots must never use a paid inference key.
CONWAY_API_KEY=dummy-not-a-real-key
